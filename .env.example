# --- Entorno y Aplicación ---
PROJECT_NAME="SoftEdu AI-Powered LMS/SIS"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"
DEBUG=false
APP_URL=https://softedu.servigest.online
ALLOWED_HOSTS=softedu.servigest.online,www.softedu.servigest.online,127.0.0.1,localhost

# --- Base de Datos PostgreSQL + asyncpg + pgvector ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=softedu
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=softedu_db
# Opcional URL directa para producción:
# DATABASE_URL=postgresql+asyncpg://softedu:your_db_password@127.0.0.1:5432/softedu_db

# --- Seguridad JWT & RBAC ---
JWT_SECRET_KEY="change-this-super-secret-jwt-key-in-production-env-256bits"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Motor de IA / LLM (Google Gemini o OpenAI) ---
AI_PROVIDER="gemini"
AI_API_KEY="TU_API_KEY_DE_GEMINI_O_OPENAI"
AI_MODEL_NAME="gemini-2.5-flash"
AI_EMBEDDING_MODEL_NAME="text-embedding-004"
AI_EMBEDDING_DIMENSION=768
AI_REQUEST_TIMEOUT_SECONDS=25.0
AI_TEMPERATURE=0.2

# --- Reglas de Negocio Académicas (MEN / Colombia) ---
MIN_GRADE_SCALE=0.0
MAX_GRADE_SCALE=5.0
MIN_PASSING_GRADE=3.0
MAX_ABSENCE_PERCENTAGE_ALLOWED=20.0
